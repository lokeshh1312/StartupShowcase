# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_NAME="Startup Showcase"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres connection string)
DATABASE_URL=

# Email & Newsletter (Resend - Phase 5B)
# REQUIRED IN PRODUCTION
RESEND_API_KEY=
EMAIL_FROM="Startup Showcase <updates@yourdomain.com>"
NEWSLETTER_SECRET=

# Cloudflare Turnstile CAPTCHA (Phase 5B)
# REQUIRED IN PRODUCTION
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth (Phase 5B)
# Set to 'true' to enable Google Sign-In button
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Security & Proxy Configuration
# Number of trusted reverse proxies in front of the application.
# MANDATORY in production (NODE_ENV=production): must be explicitly set (even to 0).
# On the real host, this must match the exact number of reverse proxies in front of the app,
# determined during deployment. In dev/test, defaults to 0.
TRUSTED_PROXY_COUNT=0

# Secret salt for deduplicating startup views (required in production)
VIEW_HASH_SECRET=

# Optional: Privacy Analytics (Plausible or PostHog)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: Error Tracking (Sentry DSN)
SENTRY_DSN=

# Payments (Razorpay Submissions - USD & INR/UPI)
# REQUIRED IN PRODUCTION
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
SUBMISSION_PRICE_USD_CENTS=1000
# Optional: Submission listing fee in INR paise (defaults to 99900 = ₹999.00)
SUBMISSION_PRICE_INR_PAISE=99900
# Safety flag: Set to 'true' ONLY if intentionally testing Razorpay test keys in production
ALLOW_RAZORPAY_TEST_IN_PRODUCTION=false
